{
  "manifest_version": 3,
  "name": "Perusall Booster",
  "short_name": "Perusall Booster",
  "version": "0.1.0",
  "description": "Personal reading timer, goals and session history for Perusall readers. Separate from Perusall's official records.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Perusall Booster \u2014 personal reading timer",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "pages/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "idle",
    "notifications"
  ],
  "host_permissions": [
    "https://app.perusall.com/*"
  ]
}
